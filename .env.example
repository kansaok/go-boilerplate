APP_NAME="Go Boilerplate"
#local | staging | production
APP_ENV=local

# allowed hosts (comma-separated, e.g. localhost,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# allowed origins for CORS (comma-separated, e.g. https://yourdomain.com,http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

#boolean : true | false
SECURE_SSL_REDIRECT=false
#boolean : true | false
CSRF_COOKIE_SECURE=false
#boolean : true | false
SESSION_COOKIE_SECURE=false
#boolean : true | false
SECURE_BROWSER_XSS_FILTER=true
#boolean : true | false
SECURE_CONTENT_TYPE_NOSNIFF=true

# batas ukuran body request per request (bytes). default: 16777216 (16MB)
MAX_BODY_BYTES=16777216

# Proteksi endpoint /metrics:
# 1) jika METRICS_USER+METRICS_PASSWORD diisi -> wajib HTTP Basic Auth
# 2) jika kosong -> hanya IP loopback / CIDR di METRICS_ALLOWLIST yang boleh akses
METRICS_USER=
METRICS_PASSWORD=
# comma-separated CIDR, contoh: 10.0.0.0/8,192.168.0.0/16
METRICS_ALLOWLIST=

# REQUIRED: Generate a strong secret (min 32 chars), e.g. openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_LIFETIME=15m
REFRESH_TOKEN_LIFETIME=168h

# MAIL SERVER
EMAIL_HOST=
#boolean : true | false
EMAIL_USE_TLS=
#boolean : true | false
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=

#debug | release
GIN_MODE=debug

# postgres | mysql | sqlite | mongodb
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# just for postgres : disable | require | verify-full
DB_SSLMODE=require
# just for sqlite
DB_FILE=./storage/sqlite/mydatabase.db
# S3 bucket name for file uploads
S3_BUCKET_NAME=

# REDIS (opsional) - untuk per-account rate limiting (login/registrasi)
# wajib di-set untuk deployment multi-instance; kosongkan REDIS_HOST untuk in-memory fallback
# REDIS_PASSWORD WAJIB diisi (generate misal: openssl rand -hex 24) jika menjalankan
# service redis lewat docker-compose - container redis akan gagal start tanpa ini
# supaya Redis tidak pernah berjalan tanpa autentikasi.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

APP_PORT=8080
